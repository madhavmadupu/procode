    "@procode/knowledge-graph": "workspace:*",
    "@procode/llm-client": "workspace:*",
    "@procode/lsp-host": "workspace:*",
    "@procode/rag-pipeline": "workspace:*",
    "@procode/terminal": "workspace:*",
    "@procode/types": "workspace:*",
    "@procode/utils": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
